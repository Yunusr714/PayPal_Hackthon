# Cashiko Environment Variables Template
ENVIRONMENT=development
DEMO_MODE=false

# PayPal Sandbox Credentials (from developer.paypal.com)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=http://localhost:8000/api/v1/webhooks/paypal

# Database
DATABASE_URL=sqlite+aiosqlite:///./flowcollect.db

# AI Provider Configuration (Groq / Gemini / OpenAI)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Fallback Merchant Settings
MERCHANT_BUSINESS_NAME="Cashiko Store"
MERCHANT_LOGO_URL="https://images.unsplash.com/photo-1558769132-cb1aea458c5e?w=250&auto=format&fit=crop&q=80"
MERCHANT_WEBSITE="https://cashiko.io"
MERCHANT_EMAIL=""
MERCHANT_CONTACT_NAME="Business Owner"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Cashiko Invoicing"
